# Copy this file to .env and fill in your values. Never commit .env.

S3_BUCKET=your-bucket-name
AWS_REGION=eu-central-1

# Local copies on the training machine
DATA_DIR=/home/ubuntu/data
WEIGHTS_DIR=/home/ubuntu/weights

# SageMaker MLflow tracking server ARN, or http://<host>:5000 if self-hosted
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=brain-tumor-uncertainty
